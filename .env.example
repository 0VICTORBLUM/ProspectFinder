# ===== Acesso =====
# Token de acesso da aplicação (obrigatório em produção). Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ACCESS_TOKEN=

# ===== Google Sheets (persistência dos leads) =====
# ID da planilha: trecho entre /d/ e /edit na URL.
GOOGLE_SHEETS_ID=
# Opção 1: e-mail e chave privada da conta de serviço (a chave mantém os "\n" literais).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Opção 2 (alternativa): JSON completo da conta de serviço em uma linha.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ===== Fonte A: Dados Abertos do CNPJ (arquivo filtrado gerado por `npm run import:cnpj`) =====
CNPJ_DATA_FILE=data/cnpj/empresas.jsonl

# ===== Execução das pesquisas =====
# Tempo máximo (ms) de cada lote de pesquisa; mantenha abaixo do limite da função na Vercel.
SEARCH_STEP_BUDGET_MS=15000
SEARCH_MAX_LIMIT=500
# Enriquecimento por sites oficiais
ENRICHMENT_TIMEOUT_MS=6000
ENRICHMENT_USER_AGENT=ProspectFinderBot/0.1 (+contato: defina-seu-email)

# ===== Demonstração =====
# "true" habilita a fonte de dados fictícios (sempre identificada como demonstração).
ENABLE_DEMO_SOURCE=true
